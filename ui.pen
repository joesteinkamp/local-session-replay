        {
          "type": "frame",
          "id": "jLTid",
          "x": 2496,
          "y": 3230,
          "name": "07 · Simplified panel alternatives",
          "opacity": 0.55,
          "fill": "$board-bg",
          "cornerRadius": 16,
          "layout": "vertical",
          "gap": 56,
          "padding": 56,
          "children": [
            {
              "type": "frame",
              "id": "x10HWz",
              "name": "Header",
              "width": 1000,
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "b3vGTE",
                  "name": "Eyebrow",
                  "fill": "$tk-accent",
                  "content": "OVERLAY · EXPLORATION",
                  "lineHeight": 1.45,
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fontWeight": "700",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "M89A6",
                  "name": "Title",
                  "fill": "$tk-text",
                  "content": "Simpler panels: fewer buttons, same jobs",
                  "lineHeight": 1.2,
                  "fontFamily": "$font",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "dLL58",
                  "name": "Desc",
                  "fill": "$tk-text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Today’s panels show 4 buttons in setup, 5 while recording, and 3 after stopping, plus checkboxes, disclosures, and inline confirms. Three ways to cut that down, each walked through the same moments. Yellow chips count the buttons visible at once (icon buttons included).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "G6cTt",
              "name": "A · One primary + overflow",
              "gap": 32,
              "children": [
                {
                  "type": "frame",
                  "id": "g8voAp",
                  "name": "Info",
                  "width": 260,
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "LfDk0",
                      "name": "Tag",
                      "fill": "$bubble-bg",
                      "content": "DIRECTION A",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 11,
                      "fontWeight": "700",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "zB3G2",
                      "name": "Name",
                      "fill": "$tk-text",
                      "content": "One primary + overflow",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "ltxWF",
                      "name": "Idea",
                      "fill": "$tk-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every panel gets exactly one primary button. Pause and Mute become icons in the header; everything rare (Skip, Stop, Discard, Start new, screen-only) moves into a ⋯ menu.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "e3IKj",
                      "name": "Trade-off",
                      "fill": "$tk-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Nothing is removed, so it’s the safest change, but rare actions are a click deeper.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
