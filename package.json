{
  "name": "testkit",
  "version": "1.0.0",
  "private": true,
  "description": "Local session replay & think-aloud toolkit for GitLab Pages prototypes",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/build.mjs && python3 -m http.server 8080 --bind 0.0.0.0 --directory public",
    "test": "node --test 'test/*.test.js'"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "rrweb": "2.1.7",
    "rrweb-player": "2.1.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
