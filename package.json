{
  "name": "local-session-replay",
  "version": "1.0.0",
  "private": true,
  "description": "Local session replay & think-aloud toolkit for web prototypes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script/*": "./dist/script/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/script/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/build.mjs && python3 -m http.server 8080 --bind 0.0.0.0 --directory public",
    "test": "node --test 'test/*.test.js'",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "rrweb": "2.1.7",
    "rrweb-player": "2.1.7",
    "esbuild": "0.28.2"
  }
}
